# Copy this file to .env and fill in your provider details.
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.
#
# IMPORTANT: do not set ANTHROPIC_API_KEY here or in your shell. A globally set
# ANTHROPIC_API_KEY makes Claude Code bill at pay-as-you-go API rates instead of
# using your Pro subscription. This project does not use Anthropic at all.

# ---------------------------------------------------------------------------
# Pick ONE provider block below, uncomment it, and leave the rest commented.
# All of them speak the OpenAI-compatible protocol, so only these three values
# ever change.
# ---------------------------------------------------------------------------

# --- Ollama (local, free, unlimited, private, works offline) ----------------
# Install: brew install ollama && ollama serve
# Pull a model: ollama pull qwen3:14b
# No real API key needed, but the OpenAI client requires the field to be non-empty.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:14b

# --- Groq (free tier, very fast, ~30 requests/min) -------------------------
# Get a key: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (free tier, ~30 free models behind one endpoint) -----------
# Get a key: https://openrouter.ai/keys
# Free models carry a ":free" suffix.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=qwen/qwen3-14b:free

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------

# Seconds to wait for a response. Local models on first load can be slow, and
# reasoning models are slower still.
# LLM_TIMEOUT=120

# 0.0 = most deterministic. Keep this low: we want consistent, grounded analysis,
# not creative writing.
# LLM_TEMPERATURE=0.2
